<Project>
  <PropertyGroup Label="Package settings">
    <Title>$(MSBuildProjectName)</Title>
    <Description></Description>
    <RepositoryUrl>https://github.com/dailydevops/analyzer</RepositoryUrl>
    <PackageProjectUrl>https://github.com/dailydevops/analyzer</PackageProjectUrl>
    <PackageReleaseNotes>$(PackageProjectUrl)/releases</PackageReleaseNotes>
    <PackageTags></PackageTags>
    <CopyrightYearStart>2024</CopyrightYearStart>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Workaround, until https://github.com/GitTools/GitVersion/pull/4206 is released -->
    <GitVersionTargetFramework>net10.0</GitVersionTargetFramework>
  </PropertyGroup>
</Project>
